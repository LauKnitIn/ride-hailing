meta {
  name: B - Solicitar viaje
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/viajes
  body: json
  auth: none
}

body:json {
  {
    "pasajeroId": "{{pasajeroId}}",
    "latitudOrigen": 4.711,
    "longitudOrigen": -74.0721,
    "latitudDestino": 4.65,
    "longitudDestino": -74.1
  }
}

vars:post-response {
  viajeBId: res.body.id
}

assert {
  res.status: eq 200
}

docs {
  Ejecuta antes la carpeta '1 Flujo completo' (usa pasajeroId y conductorId).
}
