meta {
  name: B - Cargo parcial
  type: http
  seq: 5
}

get {
  url: {{tarifasUrl}}/api/tarifas/{{viajeBId}}/cargo-parcial
  body: none
  auth: none
}

vars:pre-request {
  tarifasUrl: localhost:8000
}

assert {
  res.status: eq 200
  res.body.monto: eq 2500
}

docs {
  50% de la tarifa minima (5000).
}
