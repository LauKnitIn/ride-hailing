meta {
  name: Calificar conductor
  type: http
  seq: 21
}

post {
  url: {{calificacionesUrl}}/api/calificaciones
  body: json
  auth: none
}

body:json {
  {
    "viajeId": "{{viajeId}}",
    "pasajeroId": "{{pasajeroId}}",
    "puntuacion": 5,
    "comentario": "Excelente servicio"
  }
}

vars:pre-request {
  calificacionesUrl: localhost:8000
}

assert {
  res.status: eq 200
}

docs {
  HU-08.
}
